#!/usr/bin/env bash

if [[ -n $1 ]]; then
x=$1
else
read -p 'enter file name' x
fi
if [ -e "$x" ]; then
echo "file already exists use different name" >&2
exit 1
else

touch $x
chmod +x $x

echo "#!/usr/bin/env bash" >> $x
echo "$x sucessfully created"
fi

#this creates a executable bash file(only 1 file at a time tho) 
